/* ============================
   Design System v2 — Modern SaaS
   ============================ */

/* Google Fonts */
@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap');

/* ==================== CSS 变量 ==================== */
:root {
  /* ---- 主色调 ---- */
  --color-primary: #005eeb;
  --color-primary-hover: #1a73e8;
  --color-primary-light-9: #e5eefd;
  --color-on-primary: #ffffff;

  /* ---- 中性灰阶 — 全链路使用 ---- */
  --gray-50:  #f9fafb;
  --gray-100: #f3f4f6;
  --gray-200: #e5e7eb;
  --gray-300: #d1d5db;
  --gray-400: #9ca3af;
  --gray-500: #6b7280;
  --gray-600: #4b5563;
  --gray-700: #374151;
  --gray-800: #1f2329;
  --gray-900: #111827;

  /* ---- 文字语义色 — 替换所有硬编码文字色 ---- */
  --color-text-primary:   #1f2329;   /* 标题/正文 */
  --color-text-secondary: #5f6368;   /* 次要文字 */
  --color-text-muted:     #9ca3af;   /* 占位/禁用 */
  --color-text-placeholder: #c4c9d4; /* 输入框占位 */
  --color-text-inverse:   #ffffff;   /* 深色背景上的文字 */

  /* ---- 边框/分割线 — 替换所有硬编码边框色 ---- */
  --color-border:        #e5e7eb;   /* 默认边框 */
  --color-border-light:  #f0f1f3;   /* 浅分割线 */
  --color-border-focus:  var(--color-primary); /* 聚焦边框 */
  --color-border-hover:  #c9cdd4;   /* 悬停边框 */

  /* ---- 状态色 — 饱和纯色风格 ---- */
  --color-success:      #059669;
  --color-success-bg:   rgba(5, 150, 105, 0.1);
  --color-success-text: #064e3b;
  --color-warning:      #d97706;
  --color-warning-bg:   rgba(217, 119, 6, 0.1);
  --color-warning-text: #451a03;
  --color-danger:       #dc2626;
  --color-danger-bg:    rgba(220, 38, 38, 0.1);
  --color-danger-text:  #450a0a;
  --color-info:         #0891b2;
  --color-info-bg:      rgba(8, 145, 178, 0.1);
  --color-info-text:    #0c4a6e;

  /* ---- 趋势色 — Dashboard 专用 ---- */
  --color-trend-up:    #22c55e;
  --color-trend-down:  #ef4444;
  --color-trend-up-bg:    rgba(34, 197, 94, 0.1);
  --color-trend-down-bg:  rgba(239, 68, 68, 0.1);
  --color-badge-dot:   #ef4444;

  /* ---- Chart 色系 — ECharts 统一配色 ---- */
  --chart-blue:   #3b82f6;
  --chart-purple: #8b5cf6;
  --chart-cyan:   #06b6d4;
  --chart-green:  #22c55e;
  --chart-amber:  #f59e0b;
  --chart-pink:   #ec4899;
  --chart-red:    #ef4444;
  --chart-indigo: #6366f1;
  --chart-teal:   #14b8a6;

  /* ---- 页面背景 — 全局统一 ---- */
  --color-page-bg:     #f0f2f7;  /* 应用主背景 */
  --color-surface:     #ffffff;  /* 卡片/面板背景 */
  --color-surface-2:   #f8f9fc;  /* 次级面板 */
  --color-surface-3:   #f4f5f7;  /* 表格头/工具栏 */

  /* ---- 圆角 — 统一半径体系 ---- */
  --radius-xs:  3px;
  --radius-sm:  6px;
  --radius-md:  8px;
  --radius-lg:  12px;
  --radius-xl:  16px;
  --radius-2xl: 20px;
  --radius-full: 9999px;

  /* ---- 间距 ---- */
  --space-1:  4px;
  --space-2:  8px;
  --space-3:  12px;
  --space-4:  16px;
  --space-5:  20px;
  --space-6:  24px;
  --space-8:  32px;
  --space-10: 40px;

  /* ---- 阴影 — 层次体系 ---- */
  --shadow-xs: 0 1px 2px rgba(0, 0, 0, 0.04);
  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.06), 0 0 0 1px rgba(0, 0, 0, 0.02);
  --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.08), 0 0 0 1px rgba(0, 0, 0, 0.02);
  --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.1),  0 0 0 1px rgba(0, 0, 0, 0.02);
  --shadow-xl: 0 16px 48px rgba(0, 0, 0, 0.12), 0 0 0 1px rgba(0, 0, 0, 0.02);

  /* ---- 过渡 ---- */
  --ease-out:   cubic-bezier(0.4, 0, 0.2, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  --duration-fast: 0.15s;
  --duration-normal: 0.25s;
  --duration-slow: 0.4s;
}

/* ==================== 深色模式（与 Element Plus el-theme-dark 联动） ==================== */
html.el-theme-dark {
  --color-primary: #3b82f6;
  --color-primary-hover: #60a5fa;
  --color-primary-light-9: rgba(59, 130, 246, 0.15);
  --color-on-primary: #ffffff;

  --color-text-primary: #e4e7ed;
  --color-text-secondary: #a0a8b0;
  --color-text-muted: #6b7280;
  --color-text-placeholder: #4b5563;
  --color-text-inverse: #0f172a;

  --color-border: #334155;
  --color-border-light: #1e293b;
  --color-border-focus: var(--color-primary);
  --color-border-hover: #475569;

  --color-success: #10b981;
  --color-success-bg: rgba(16, 185, 129, 0.15);
  --color-success-text: #6ee7b7;
  --color-warning: #f59e0b;
  --color-warning-bg: rgba(245, 158, 11, 0.15);
  --color-warning-text: #fcd34d;
  --color-danger: #f87171;
  --color-danger-bg: rgba(248, 113, 113, 0.15);
  --color-danger-text: #fca5a5;
  --color-info: #38bdf8;
  --color-info-bg: rgba(56, 189, 248, 0.15);
  --color-info-text: #7dd3fc;

  --color-trend-up: #4ade80;
  --color-trend-down: #f87171;
  --color-trend-up-bg: rgba(74, 222, 128, 0.12);
  --color-trend-down-bg: rgba(248, 113, 113, 0.12);
  --color-badge-dot: #f87171;

  --chart-blue:   #60a5fa;
  --chart-purple: #a78bfa;
  --chart-cyan:   #22d3ee;
  --chart-green:  #4ade80;
  --chart-amber:  #fbbf24;
  --chart-pink:   #f472b6;
  --chart-red:    #fb7185;
  --chart-indigo: #818cf8;
  --chart-teal:   #2dd4bf;

  --color-page-bg: #0f172a;
  --color-surface: #1e293b;
  --color-surface-2: #263549;
  --color-surface-3: #2d3a4f;

  --shadow-xs: 0 1px 2px rgba(0, 0, 0, 0.3);
  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(255, 255, 255, 0.05);
  --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.05);
  --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.05);
  --shadow-xl: 0 16px 48px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.05);

  /* 侧边栏深色适配 */
  --theme-main-bg: #0f172a;
  --color-scrollbar: #374151;
  --color-scrollbar-hover: #4b5563;
}

/* ==================== 基础重置 ==================== */
*, *::before, *::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

html, body {
  width: 100%;
  height: 100%;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 14px;
  line-height: 1.5;
  color: var(--color-text-primary);
  background-color: var(--color-page-bg);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

#app {
  width: 100%;
  height: 100%;
}

/* ==================== 表格操作列 ==================== */
/* 紧凑型图标按钮：26px × N 个按钮，替代旧版 ghost button */
/* 样式已封装在 TableActions.vue 组件中，此处为 el-dropdown menu 覆盖 */
.el-dropdown-menu__item {
  font-size: 13px;
  color: var(--color-text-primary);
  padding: 6px 14px;
  &:hover { background: var(--gray-50); color: var(--color-primary); }
}

h1, h2, h3, h4, h5, h6 {}

h1, h2, h3, h4, h5, h6 {
  font-family: 'Manrope', sans-serif;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.3;
}

a { color: var(--color-primary); text-decoration: none; }
a:hover { color: var(--color-primary-hover); }

/* ==================== 滚动条 ==================== */
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb {
  background: var(--gray-300);
  border-radius: var(--radius-full);
}
::-webkit-scrollbar-thumb:hover { background: var(--gray-400); }

/* ==================== 选择文字颜色 ==================== */
::selection {
  background: var(--color-primary-light-9);
  color: var(--color-primary);
}

/* ==================== Element Plus 全局覆盖 ==================== */

/* 按钮 — 添加按压动效 */
.el-button {
  border-radius: var(--radius-md) !important;
  font-weight: 500;
  transition: all var(--duration-fast) var(--ease-out) !important;
  cursor: pointer;
  user-select: none;
}
.el-button:active:not(:disabled) {
  transform: scale(0.97) !important;
}
.el-button--primary {
  background: var(--color-primary) !important;
  border-color: var(--color-primary) !important;
  box-shadow: 0 2px 8px rgba(0, 94, 235, 0.25) !important;
}
.el-button--primary:hover:not(:disabled) {
  background: var(--color-primary-hover) !important;
  border-color: var(--color-primary-hover) !important;
  box-shadow: 0 4px 16px rgba(0, 94, 235, 0.35) !important;
  transform: translateY(-1px) !important;
}
.el-button--primary:active:not(:disabled) {
  transform: scale(0.97) !important;
  box-shadow: 0 1px 4px rgba(0, 94, 235, 0.2) !important;
}
.el-button--success {
  background: var(--color-success) !important;
  border-color: var(--color-success) !important;
  box-shadow: 0 2px 8px rgba(22, 163, 74, 0.25) !important;
}
.el-button--success:hover:not(:disabled) {
  background: #15803d !important;
  transform: translateY(-1px) !important;
  box-shadow: 0 4px 16px rgba(22, 163, 74, 0.35) !important;
}
.el-button--danger {
  background: var(--color-danger) !important;
  border-color: var(--color-danger) !important;
  box-shadow: 0 2px 8px rgba(220, 38, 38, 0.25) !important;
}
.el-button--danger:hover:not(:disabled) {
  background: #b91c1c !important;
  transform: translateY(-1px) !important;
}
.el-button--warning {
  background: var(--color-warning) !important;
  border-color: var(--color-warning) !important;
}
.el-button--default {
  background: var(--gray-100) !important;
  border-color: var(--gray-200) !important;
  color: var(--color-text-primary) !important;
}
.el-button--default:hover:not(:disabled) {
  background: var(--gray-200) !important;
  border-color: var(--gray-300) !important;
  color: var(--color-text-primary) !important;
}

/* 表格 */
.el-table {
  --el-table-bg-color: transparent;
  --el-table-tr-bg-color: transparent;
  --el-table-header-bg-color: var(--gray-50);
  --el-table-row-hover-bg-color: rgba(0, 94, 235, 0.04);
  --el-table-border-color: var(--color-border-light);
  font-size: 12px;
  --el-table-font-size: 12px;
}
.el-table th.el-table__cell {
  background-color: var(--gray-50) !important;
  color: var(--color-text-secondary) !important;
  font-weight: 600;
  font-size: 11.5px;
  text-transform: none;
  letter-spacing: 0;
  border-bottom: 1px solid var(--color-border) !important;
  padding: 10px 0 !important;
}
.el-table td.el-table__cell {
  border-bottom: 1px solid var(--color-border-light) !important;
  color: var(--color-text-primary);
  font-size: 12px;
  padding: 9px 0 !important;
}
/* 单元格文字溢出省略 */
.el-table td.el-table__cell .cell {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.5;
  padding-left: 4px;
  padding-right: 4px;
}
.el-table__body tr:hover > td.el-table__cell {
  background-color: rgba(0, 94, 235, 0.04) !important;
}
.el-table__empty-text {
  color: var(--color-text-muted);
  font-size: 12px;
}

/* 标签 */
.el-tag {
  border-radius: var(--radius-full) !important;
  font-weight: 500;
  font-size: 11px;
  padding: 0 10px;
  height: 22px;
  line-height: 20px;
  border: none !important;
}
.el-tag--success { background: var(--color-success-bg) !important; color: var(--color-success-text) !important; }
.el-tag--warning { background: var(--color-warning-bg) !important; color: var(--color-warning-text) !important; }
.el-tag--danger  { background: var(--color-danger-bg) !important;  color: var(--color-danger-text) !important; }
.el-tag--info    { background: var(--gray-100) !important; color: var(--color-text-secondary) !important; }

/* 卡片 */
.el-card { border: none !important; border-radius: var(--radius-lg) !important; box-shadow: var(--shadow-sm); }

/* 分页 */
.el-pagination {
  --el-pagination-bg-color: transparent;
  --el-pagination-hover-color: var(--color-primary);
}
.el-pagination .el-pager li {
  border-radius: var(--radius-md) !important;
  font-weight: 500;
  transition: all var(--duration-fast) var(--ease-out);
}
.el-pagination .el-pager li:hover { color: var(--color-primary) !important; }
.el-pagination .el-pager li.is-active {
  background: var(--color-primary) !important;
  color: white !important;
  box-shadow: 0 2px 8px rgba(0, 94, 235, 0.3) !important;
}

/* ============================
   Dialog — Industrial Precision
   Flat, typographic, zero gradients
   ============================ */
.el-overlay {
  background: rgba(15, 23, 42, 0.4) !important;
}
.el-dialog {
  border-radius: var(--radius-xl) !important;
  overflow: hidden;
  box-shadow: 0 24px 64px rgba(0,0,0,0.15), 0 0 0 1px rgba(0,0,0,0.05) !important;
  border: none !important;
  animation: dialog-in 0.2s var(--ease-out);
}
@keyframes dialog-in {
  from { opacity: 0; transform: translateY(-6px) scale(0.98); }
  to   { opacity: 1; transform: translateY(0)    scale(1); }
}

/* Header: flat white, left accent bar */
.el-dialog__header {
  background: var(--color-surface) !important;
  padding: 0 !important;
  margin: 0 !important;
  border-bottom: 1px solid var(--color-border-light) !important;
  min-height: 52px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.el-dialog__title {
  font-family: 'Manrope', sans-serif !important;
  font-weight: 600 !important;
  font-size: 15px !important;
  color: var(--color-text-primary) !important;
  letter-spacing: 0.2px;
  padding: 0 !important;
  flex: 1;
}
.el-dialog__headerbtn {
  position: static !important;
  width: 40px !important;
  height: 40px !important;
  flex-shrink: 0;
  background: transparent !important;
  border: none !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  cursor: pointer;
  transition: background var(--duration-fast) var(--ease-out);
  border-radius: 0 var(--radius-xl) 0 0;
}
.el-dialog__headerbtn:hover {
  background: var(--gray-50) !important;
}
.el-dialog__headerbtn .el-icon {
  color: var(--gray-400);
  transition: color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
}
.el-dialog__headerbtn:hover .el-icon {
  color: var(--color-text-primary);
  transform: scale(1.1);
}
.el-dialog__body {
  padding: 20px 24px !important;
  color: var(--color-text-primary);
  font-size: 14px;
}
.el-dialog__footer {
  padding: 14px 20px !important;
  background: var(--gray-50);
  border-top: 1px solid var(--color-border-light);
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: var(--space-2);
}

/* ============================
   Form Controls — Industrial Precision
   Flat inputs, sharp focus, clear states
   ============================ */

/* Form labels */
.el-form-item__label {
  color: var(--color-text-secondary) !important;
  font-weight: 500;
  font-size: 12.5px;
  letter-spacing: 0.1px;
  line-height: 1.4;
  padding: 0 0 6px 0 !important;
}
.el-form-item__label::before { display: none !important; }
.el-form-item {
  --el-form-label-font-size: 12.5px;
  margin-bottom: 14px;
}
.el-form-item:last-child { margin-bottom: 0; }

/* Input */
.el-input__wrapper {
  background-color: var(--color-surface) !important;
  border-radius: var(--radius-md) !important;
  box-shadow: none !important;
  border: 1.5px solid var(--color-border) !important;
  transition: border-color var(--duration-fast) var(--ease-out),
              box-shadow var(--duration-fast) var(--ease-out) !important;
}
.el-input__wrapper:hover {
  border-color: var(--color-border-hover) !important;
}
.el-input__wrapper.is-focus {
  border-color: var(--color-primary) !important;
  box-shadow: 0 0 0 3px rgba(0, 94, 235, 0.07) !important;
}
.el-input__wrapper.is-error {
  border-color: var(--color-danger) !important;
}
.el-input__wrapper.is-disabled {
  background-color: var(--gray-50) !important;
  border-color: var(--gray-200) !important;
}
.el-input__inner {
  color: var(--color-text-primary) !important;
  font-size: 13.5px;
}
.el-input__inner::placeholder {
  color: var(--color-text-placeholder) !important;
}
.el-input__prefix { color: var(--gray-400); }
.el-input__suffix { color: var(--gray-400); }
.el-input__count { color: var(--gray-400); font-size: 11px; }

/* Textarea */
.el-textarea__inner {
  background-color: var(--color-surface) !important;
  border-radius: var(--radius-md) !important;
  box-shadow: none !important;
  border: 1.5px solid var(--color-border) !important;
  transition: border-color var(--duration-fast) var(--ease-out),
              box-shadow var(--duration-fast) var(--ease-out) !important;
  color: var(--color-text-primary) !important;
  font-size: 13.5px;
  resize: vertical;
  min-height: 80px;
}
.el-textarea__inner:hover { border-color: var(--color-border-hover) !important; }
.el-textarea__inner:focus {
  border-color: var(--color-primary) !important;
  box-shadow: 0 0 0 3px rgba(0, 94, 235, 0.07) !important;
}
.el-textarea__inner::placeholder { color: var(--color-text-placeholder) !important; }

/* Select */
.el-select__wrapper {
  background-color: var(--color-surface) !important;
  border-radius: var(--radius-md) !important;
  box-shadow: none !important;
  border: 1.5px solid var(--color-border) !important;
  transition: border-color var(--duration-fast) var(--ease-out),
              box-shadow var(--duration-fast) var(--ease-out) !important;
}
.el-select__wrapper:hover { border-color: var(--color-border-hover) !important; }
.el-select__wrapper.is-focus {
  border-color: var(--color-primary) !important;
  box-shadow: 0 0 0 3px rgba(0, 94, 235, 0.07) !important;
}
.el-select-dropdown__item {
  border-radius: var(--radius-sm) !important;
  margin: 2px 8px !important;
  font-size: 13px;
}
.el-select-dropdown__item.is-selected {
  background: rgba(0, 94, 235, 0.06) !important;
  color: var(--color-primary) !important;
  font-weight: 600;
}
.el-select-dropdown__item:hover { background: var(--gray-50) !important; }

/* Date picker */
.el-date-editor.el-input__wrapper {
  border-radius: var(--radius-md) !important;
}
.el-picker__popper {
  border-radius: var(--radius-lg) !important;
  border: 1px solid var(--color-border-light) !important;
  box-shadow: var(--shadow-lg) !important;
}

/* Input Number */
.el-input-number {
  --el-input-number-border-step: none;
}
.el-input-number__decrease,
.el-input-number__increase {
  background: var(--gray-50) !important;
  border-color: var(--color-border-light) !important;
  color: var(--gray-500);
  &:hover { color: var(--color-primary) !important; }
}

/* Switch */
.el-switch {
  --el-switch-off-color: var(--gray-200);
  --el-switch-on-color: var(--color-primary);
}
.el-switch__core {
  border-radius: 12px;
  transition: background var(--duration-fast) var(--ease-out);
}
.el-switch.is-checked .el-switch__core {
  background: var(--color-primary) !important;
  border-color: var(--color-primary) !important;
}

/* Checkbox */
.el-checkbox__input.is-checked .el-checkbox__inner {
  background: var(--color-primary) !important;
  border-color: var(--color-primary) !important;
}
.el-checkbox__label { font-size: 13px; color: var(--color-text-primary); }

/* Radio */
.el-radio__input.is-checked .el-radio__inner {
  background: var(--color-primary) !important;
  border-color: var(--color-primary) !important;
}

/* Cascader */
.el-cascader__wrapper {
  border-radius: var(--radius-md) !important;
}
.el-cascader-panel {
  border-radius: var(--radius-lg) !important;
  border: 1px solid var(--color-border-light) !important;
  box-shadow: var(--shadow-lg) !important;
}

/* Form validation error */
.el-form-item__error {
  font-size: 11.5px;
  color: var(--color-danger);
  padding-top: 3px;
}
.el-form-item.is-error .el-input__wrapper {
  border-color: var(--color-danger) !important;
}
.el-form-item.is-error .el-input__wrapper:focus {
  box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.07) !important;
}

/* ============================
   Drawer — Industrial Precision
   ============================ */
.el-drawer {
  border-radius: var(--radius-xl) 0 0 var(--radius-xl) !important;
}
.el-drawer__header {
  padding: 18px 20px !important;
  margin-bottom: 0 !important;
  border-bottom: 1px solid var(--color-border-light) !important;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.el-drawer__title {
  font-family: 'Manrope', sans-serif !important;
  font-weight: 700 !important;
  font-size: 14px !important;
  color: var(--color-text-primary) !important;
}
.el-drawer__headerbtn {
  width: 32px !important;
  height: 32px !important;
  border-radius: var(--radius-md) !important;
  transition: background var(--duration-fast) var(--ease-out);
  &:hover { background: var(--gray-100) !important; }
}
.el-drawer__headerbtn .el-icon { color: var(--gray-500); }
.el-drawer__body {
  padding: 20px !important;
}

/* ============================
   Descriptions (detail view)
   ============================ */
.el-descriptions__cell { padding: 10px 16px !important; }
.el-descriptions__label {
  background-color: var(--gray-50) !important;
  color: var(--color-text-secondary) !important;
  font-weight: 500;
  font-size: 12.5px;
  border-bottom: 1px solid var(--color-border-light) !important;
}
.el-descriptions__content {
  color: var(--color-text-primary);
  font-size: 13.5px;
  border-bottom: 1px solid var(--color-border-light) !important;
}

/* 消息提示 — 现代优雅风格 */
.el-message {
  --msg-radius: 10px;
  --msg-shadow: 0 4px 24px rgba(0, 0, 0, 0.08), 0 1px 4px rgba(0, 0, 0, 0.06);
  --msg-icon-size: 16px;
  --msg-bar-width: 4px;
  --msg-padding: 14px 16px;

  padding: 0 !important;
  border: 1px solid transparent !important;
  border-radius: var(--msg-radius) !important;
  box-shadow: var(--msg-shadow) !important;
  background: transparent !important;
  overflow: visible !important;
  min-width: 280px !important;
  max-width: 420px !important;
}

/* 消息内容容器 */
.el-message__content {
  font-family: 'Manrope', 'DM Sans', sans-serif !important;
  font-size: 13px !important;
  font-weight: 500 !important;
  color: #1f2937 !important;
  line-height: 1.5 !important;
}

/* 内部 content 包裹（el-message 自带的 flex 布局） */
.el-message .el-message__content {
  padding: 0 !important;
}

/* 覆盖 Element Plus 原生结构，强制水平布局 */
.el-message > * {
  display: flex;
  align-items: center;
}

/* 整体背景 + 左侧色条 */
.el-message--success,
.el-message--error,
.el-message--warning,
.el-message--info {
  background: #fff !important;
  border: 1px solid #f0f0f0 !important;
  box-shadow: var(--msg-shadow) !important;
}

/* 左侧色条装饰 */
.el-message--success::before,
.el-message--error::before,
.el-message--warning::before,
.el-message--info::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: var(--msg-bar-width);
  border-radius: var(--msg-radius) 0 0 var(--msg-radius);
}

/* 通用内容区 */
.el-message__content {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 14px 12px 12px;
}

/* ===== success ===== */
.el-message--success {
  border-color: #bbf7d0 !important;
}
.el-message--success::before {
  background: #16a34a !important;
}
.el-message--success .el-message__content {
  color: #166534 !important;
}

/* ===== error ===== */
.el-message--error {
  border-color: #fecaca !important;
}
.el-message--error::before {
  background: #dc2626 !important;
}
.el-message--error .el-message__content {
  color: #991b1b !important;
}

/* ===== warning ===== */
.el-message--warning {
  border-color: #fde68a !important;
}
.el-message--warning::before {
  background: #d97706 !important;
}
.el-message--warning .el-message__content {
  color: #92400e !important;
}

/* ===== info ===== */
.el-message--info {
  border-color: #bae6fd !important;
}
.el-message--info::before {
  background: #0ea5e9 !important;
}
.el-message--info .el-message__content {
  color: #0369a1 !important;
}

/* 入场动画 */
.el-message {
  animation: msg-slide-in 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}
@keyframes msg-slide-in {
  from {
    opacity: 0;
    transform: translateY(-12px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* 退场动画 */
.el-message-fade-leave-active {
  transition: opacity 0.2s ease, transform 0.2s ease !important;
}
.el-message-fade-leave-to {
  opacity: 0 !important;
  transform: translateY(-8px) scale(0.96) !important;
}

/* 图标容器 */
.el-message .el-icon {
  flex-shrink: 0;
  width: 28px !important;
  height: 28px !important;
  border-radius: 8px;
  display: flex !important;
  align-items: center;
  justify-content: center;
  font-size: 14px !important;
}
.el-message--success .el-icon {
  background: #f0fdf4 !important;
  color: #16a34a !important;
}
.el-message--error .el-icon {
  background: #fef2f2 !important;
  color: #dc2626 !important;
}
.el-message--warning .el-icon {
  background: #fffbeb !important;
  color: #d97706 !important;
}
.el-message--info .el-icon {
  background: #f0f9ff !important;
  color: #0ea5e9 !important;
}

/* 关闭按钮 */
.el-message .el-message__closeBtn {
  color: #9ca3af !important;
  transition: color 0.15s !important;
  flex-shrink: 0;
  font-size: 14px !important;
  width: 20px !important;
  height: 20px !important;
  display: flex !important;
  align-items: center;
  justify-content: center;
  border-radius: 4px;
}
.el-message .el-message__closeBtn:hover {
  color: #6b7280 !important;
  background: #f3f4f6 !important;
}

/* ===== MessageBox 确认对话框 ===== */
.el-message-box {
  --mb-radius: 14px;
  border: 1px solid #e5e7eb !important;
  border-radius: var(--mb-radius) !important;
  box-shadow: 0 8px 40px rgba(0, 0, 0, 0.12), 0 2px 8px rgba(0, 0, 0, 0.06) !important;
  padding: 0 !important;
  overflow: hidden !important;
  font-family: 'Manrope', 'DM Sans', sans-serif !important;
  background: #fff !important;
  max-width: 400px !important;
}

/* ============================
   Notification — 现代通知卡片
   ============================ */
.el-notification {
  --notif-radius: 12px;
  --notif-shadow: 0 8px 32px rgba(0, 0, 0, 0.12), 0 2px 8px rgba(0, 0, 0, 0.06);
  border: 1px solid #f0f0f0 !important;
  border-radius: var(--notif-radius) !important;
  box-shadow: var(--notif-shadow) !important;
  background: #fff !important;
  padding: 0 !important;
  overflow: hidden !important;
  font-family: 'Manrope', sans-serif !important;
  max-width: 380px !important;
  min-width: 300px !important;
}

.el-notification__title {
  font-family: 'Manrope', sans-serif !important;
  font-size: 14px !important;
  font-weight: 700 !important;
  color: #111827 !important;
  margin: 0 !important;
}

.el-notification__content {
  font-size: 13px !important;
  color: #6b7280 !important;
  line-height: 1.6 !important;
  margin: 0 !important;
  padding: 0 !important;
}

.el-notification__group {
  padding: 16px 16px 16px 14px !important;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

/* 左侧色条 */
.el-notification.is-success {
  border-left: 4px solid #16a34a !important;
}
.el-notification.is-error {
  border-left: 4px solid #dc2626 !important;
}
.el-notification.is-warning {
  border-left: 4px solid #d97706 !important;
}
.el-notification.is-info {
  border-left: 4px solid #0ea5e9 !important;
}

/* 成功图标 */
.el-notification.is-success .el-notification__icon {
  color: #16a34a !important;
}
.el-notification.is-success .el-notification__title {
  color: #166534 !important;
}

/* 错误图标 */
.el-notification.is-error .el-notification__icon {
  color: #dc2626 !important;
}
.el-notification.is-error .el-notification__title {
  color: #991b1b !important;
}

/* 警告图标 */
.el-notification.is-warning .el-notification__icon {
  color: #d97706 !important;
}
.el-notification.is-warning .el-notification__title {
  color: #92400e !important;
}

/* 信息图标 */
.el-notification.is-info .el-notification__icon {
  color: #0ea5e9 !important;
}
.el-notification.is-info .el-notification__title {
  color: #0369a1 !important;
}

/* 图标样式 */
.el-notification__icon {
  width: 32px !important;
  height: 32px !important;
  font-size: 18px !important;
  margin-right: 0 !important;
}

/* 关闭按钮 */
.el-notification__closeBtn {
  color: #9ca3af !important;
  transition: all 0.15s !important;
  font-size: 14px !important;
  width: 22px !important;
  height: 22px !important;
  border-radius: 6px;
  display: flex !important;
  align-items: center;
  justify-content: center;
  position: absolute !important;
  top: 14px !important;
  right: 14px !important;
}
.el-notification__closeBtn:hover {
  color: #6b7280 !important;
  background: #f3f4f6 !important;
}

/* 入场动画 */
.el-notification {
  animation: notif-slide-in 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) both !important;
}
@keyframes notif-slide-in {
  from {
    opacity: 0;
    transform: translateX(40px) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
}

/* 退场动画 */
.el-notification-fade-leave-active {
  transition: opacity 0.2s ease, transform 0.2s ease !important;
}
.el-notification-fade-leave-to {
  opacity: 0 !important;
  transform: translateX(40px) scale(0.95) !important;
}

/* 标题 */
.el-message-box__header {
  padding: 20px 24px 0 !important;
}
.el-message-box__title {
  font-family: 'Manrope', sans-serif !important;
  font-size: 16px !important;
  font-weight: 700 !important;
  color: #111827 !important;
  display: flex !important;
  align-items: center !important;
  gap: 10px !important;
}

/* 图标在标题前 */
.el-message-box__status {
  position: static !important;
  transform: none !important;
  display: inline-flex !important;
  align-items: center !important;
  margin-right: 0 !important;
  font-size: 0 !important;
  width: auto !important;
  height: auto !important;
  min-width: 0 !important;
  min-height: 0 !important;
  vertical-align: unset !important;
}
.el-message-box__status.el-icon {
  width: 28px !important;
  height: 28px !important;
  border-radius: 8px !important;
  display: flex !important;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 内容区 */
.el-message-box__content {
  padding: 12px 24px 20px !important;
}
.el-message-box__message {
  font-size: 13px !important;
  color: #6b7280 !important;
  line-height: 1.6 !important;
  font-weight: 400 !important;
  margin-left: 0 !important;
}

/* 按钮区 */
.el-message-box__btns {
  padding: 0 24px 20px !important;
  display: flex !important;
  gap: 8px !important;
  justify-content: flex-end !important;
}
.el-message-box__btns .el-button {
  border-radius: 8px !important;
  font-family: 'Manrope', 'DM Sans', sans-serif !important;
  font-weight: 600 !important;
  font-size: 13px !important;
  padding: 8px 18px !important;
  height: auto !important;
  transition: all 0.15s !important;
}
.el-message-box__btns .el-button--primary {
  background: #005eeb !important;
  border-color: #005eeb !important;
}
.el-message-box__btns .el-button--primary:hover {
  background: #1a73e8 !important;
  border-color: #1a73e8 !important;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(0, 94, 235, 0.25) !important;
}
.el-message-box__btns .el-button--default {
  background: #f9fafb !important;
  border-color: #e5e7eb !important;
  color: #6b7280 !important;
}
.el-message-box__btns .el-button--default:hover {
  background: #f3f4f6 !important;
  border-color: #d1d5db !important;
  color: #374151 !important;
}

/* 按类型设置图标背景 */
.el-message-box__status + .el-message-box__title::before {
  display: none !important;
}

/* warning 类型 */
.el-message-box--warning .el-message-box__status.el-icon {
  background: #fffbeb !important;
  color: #d97706 !important;
}
/* error 类型 */
.el-message-box--error .el-message-box__status.el-icon {
  background: #fef2f2 !important;
  color: #dc2626 !important;
}
/* success 类型 */
.el-message-box--success .el-message-box__status.el-icon {
  background: #f0fdf4 !important;
  color: #16a34a !important;
}
/* info 类型 */
.el-message-box--info .el-message-box__status.el-icon {
  background: #f0f9ff !important;
  color: #0ea5e9 !important;
}

/* MessageBox 遮罩 */
.el-overlay {
  background: rgba(0, 0, 0, 0.3) !important;
}

/* MessageBox 入场动画 */
.el-message-box {
  animation: mb-pop-in 0.25s cubic-bezier(0.34, 1.56, 0.64, 1) both !important;
}
@keyframes mb-pop-in {
  from { opacity: 0; transform: scale(0.92) translateY(8px); }
  to   { opacity: 1; transform: scale(1)    translateY(0); }
}

/* Loading 遮罩 */
.el-loading-mask { background: rgba(255,255,255,0.9) !important; }
.el-loading-spinner .circular { animation: rotate 1.5s linear infinite; }
@keyframes rotate { to { transform: rotate(360deg); } }

/* Drawer */
.el-drawer { border-radius: var(--radius-xl) 0 0 var(--radius-xl) !important; }
.el-drawer__header {
  padding: var(--space-4) var(--space-5) !important;
  border-bottom: 1px solid var(--color-border-light) !important;
  margin-bottom: 0 !important;
  color: var(--color-text-primary) !important;
  font-family: 'Manrope', sans-serif !important;
  font-weight: 700 !important;
}
.el-drawer__body { padding: var(--space-5) !important; }
.el-drawer__footer {
  padding: var(--space-4) var(--space-5) !important;
  border-top: 1px solid var(--color-border-light) !important;
  background: var(--gray-50);
}

/* ==================== 骨架屏 — Skeleton Loader ==================== */
.skeleton {
  background: linear-gradient(
    90deg,
    var(--gray-100) 25%,
    var(--gray-50)  50%,
    var(--gray-100) 75%
  );
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.6s ease-in-out infinite;
  border-radius: var(--radius-sm);
}
@keyframes skeleton-shimmer {
  0%   { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.skeleton-text {
  height: 12px;
  margin-bottom: var(--space-2);
  border-radius: var(--radius-xs);
}
.skeleton-text:last-child { width: 60%; margin-bottom: 0; }

.skeleton-avatar {
  width: 36px;
  height: 36px;
  border-radius: var(--radius-full);
}

.skeleton-card {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  box-shadow: var(--shadow-sm);
}

.skeleton-chart {
  height: 280px;
  border-radius: var(--radius-lg);
}

/* ==================== 全局入场动画 ==================== */

/* 页面淡入 — 主容器 */
.page-enter-active,
.page-leave-active {
  transition: opacity var(--duration-normal) var(--ease-out),
              transform var(--duration-normal) var(--ease-out);
}
.page-enter-from {
  opacity: 0;
  transform: translateY(8px);
}
.page-leave-to {
  opacity: 0;
  transform: translateY(-4px);
}

/* 卡片交错入场 */
@keyframes card-in {
  from { opacity: 0; transform: translateY(12px); }
  to   { opacity: 1; transform: translateY(0); }
}
.card-appear {
  animation: card-in var(--duration-slow) var(--ease-out) both;
}
.card-appear:nth-child(1) { animation-delay: 0ms;   }
.card-appear:nth-child(2) { animation-delay: 60ms;  }
.card-appear:nth-child(3) { animation-delay: 120ms; }
.card-appear:nth-child(4) { animation-delay: 180ms; }
.card-appear:nth-child(5) { animation-delay: 240ms; }

/* 数字计数器动画 */
@keyframes counter-up {
  from { opacity: 0; transform: translateY(6px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ==================== 主题变量（侧边栏/对话框） ==================== */

/* 深邃蓝 — 默认主题：简洁纯蓝 */
:root,
[data-theme="blue"] {
  --theme-sidebar-bg-start:     #1d4ed8;
  --theme-sidebar-bg-end:       #1d4ed8;
  --theme-sidebar-active-color:  #ffffff;
  --theme-sidebar-active-bg:     rgba(255, 255, 255, 0.18);
  --theme-sidebar-active-icon-color: #ffffff;
  --theme-sidebar-text:         rgba(255, 255, 255, 0.75);
  --theme-sidebar-text-hover:    rgba(255, 255, 255, 0.95);
  --theme-sidebar-text-active:   #ffffff;
  --theme-sidebar-group-title:   rgba(255, 255, 255, 0.45);
  --theme-sidebar-group-title-hover: rgba(255, 255, 255, 0.7);
  --theme-sidebar-hover-bg:     rgba(255, 255, 255, 0.1);
  --theme-sidebar-logo-icon-bg:  rgba(255, 255, 255, 0.15);
  --theme-sidebar-border:        rgba(255, 255, 255, 0.08);
  --theme-sidebar-nav-icon:     rgba(255, 255, 255, 0.55);
  --theme-sidebar-user-avatar-bg: rgba(255, 255, 255, 0.2);
  --theme-sidebar-user-avatar-border: rgba(255, 255, 255, 0.25);
  --theme-sidebar-user-name:     #ffffff;
  --theme-sidebar-user-role:     rgba(255, 255, 255, 0.5);
  --theme-sidebar-chevron:      rgba(255, 255, 255, 0.35);
  --theme-sidebar-dropdown-bg:   #1d4ed8;
  --theme-sidebar-dropdown-border: rgba(255, 255, 255, 0.12);
  --theme-sidebar-dropdown-item: rgba(255, 255, 255, 0.8);
  --theme-sidebar-dropdown-item-hover: #ffffff;
  --theme-sidebar-dropdown-svg: rgba(255, 255, 255, 0.5);
  --theme-sidebar-danger-hover-bg: rgba(239, 68, 68, 0.2);
  --theme-sidebar-danger-hover-color: #fca5a5;
  --theme-sidebar-collapse-btn-bg: rgba(255, 255, 255, 0.1);
  --theme-sidebar-collapse-btn-color: rgba(255, 255, 255, 0.7);
  --theme-sidebar-collapse-btn-hover-bg: rgba(255, 255, 255, 0.2);
  --theme-sidebar-collapse-btn-hover-color: #ffffff;
  --theme-main-bg:     #f0f2f7;
  --theme-new-tag-bg:  #ef4444;
  --color-scrollbar: #cbd5e1;
  --color-scrollbar-hover: #94a3b8;
  --theme-badge-ad-bg: #7c3aed;
  --theme-badge-local-bg: #64748b;
  --theme-sidebar-logo-icon-color: #ffffff;
  --theme-logo-text-color: #ffffff;
  --theme-logo-text-color: #ffffff;
}

/* ==================== 通用工具类 ==================== */
.truncate {
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.font-headline { font-family: 'Manrope', sans-serif; }
.text-primary  { color: var(--color-primary); }
.text-muted    { color: var(--color-text-muted); }
.text-secondary { color: var(--color-text-secondary); }

/* 状态 Chip */
.status-chip {
  display: inline-flex; align-items: center;
  padding: 2px 10px; border-radius: var(--radius-full);
  font-size: 11px; font-weight: 600;
}
.status-chip--success { background: var(--color-success-bg); color: var(--color-success-text); }
.status-chip--warning { background: var(--color-warning-bg); color: var(--color-warning-text); }
.status-chip--danger  { background: var(--color-danger-bg);  color: var(--color-danger-text);  }
.status-chip--info    { background: var(--gray-100);         color: var(--color-text-secondary); }

/* 滚动条 */
:root {
  --color-scrollbar: #cbd5e1;
  --color-scrollbar-hover: #94a3b8;
  --theme-badge-ad-bg: #7c3aed;
  --theme-badge-local-bg: #64748b;
}

/* 深空黑主题：简洁深灰 */
[data-theme="dark"] {
  --theme-sidebar-bg-start:     #1e293b;
  --theme-sidebar-bg-end:       #1e293b;
  --theme-sidebar-active-color: #38bdf8;
  --theme-sidebar-active-bg:   rgba(56, 189, 248, 0.12);
  --theme-sidebar-active-icon-color: #38bdf8;
  --theme-sidebar-text:        rgba(186, 200, 220, 0.65);
  --theme-sidebar-text-hover:  rgba(226, 240, 255, 0.92);
  --theme-sidebar-text-active: #38bdf8;
  --theme-sidebar-group-title: rgba(56, 189, 248, 0.3);
  --theme-sidebar-group-title-hover: rgba(56, 189, 248, 0.6);
  --theme-sidebar-hover-bg:   rgba(56, 189, 248, 0.06);
  --theme-sidebar-logo-icon-bg: rgba(56, 189, 248, 0.12);
  --theme-sidebar-border:      rgba(56, 189, 248, 0.06);
  --theme-sidebar-nav-icon:    rgba(148, 163, 184, 0.4);
  --theme-sidebar-user-avatar-bg: rgba(56, 189, 248, 0.1);
  --theme-sidebar-user-avatar-border: rgba(56, 189, 248, 0.2);
  --theme-sidebar-user-name:    #e2efff;
  --theme-sidebar-user-role:    rgba(148, 163, 184, 0.45);
  --theme-sidebar-chevron:     rgba(148, 163, 184, 0.25);
  --theme-sidebar-dropdown-bg:  #0c0e16;
  --theme-sidebar-dropdown-border: rgba(56, 189, 248, 0.12);
  --theme-sidebar-dropdown-item: rgba(186, 200, 220, 0.7);
  --theme-sidebar-dropdown-item-hover: #e2efff;
  --theme-sidebar-dropdown-svg: rgba(148, 163, 184, 0.4);
  --theme-sidebar-danger-hover-bg: rgba(239, 68, 68, 0.2);
  --theme-sidebar-danger-hover-color: #fca5a5;
  --theme-sidebar-collapse-btn-bg: rgba(56, 189, 248, 0.08);
  --theme-sidebar-collapse-btn-color: rgba(148, 163, 184, 0.6);
  --theme-sidebar-collapse-btn-hover-bg: rgba(56, 189, 248, 0.18);
  --theme-sidebar-collapse-btn-hover-color: #e2efff;
  --theme-main-bg:     #f1f5f9;
  --theme-new-tag-bg:  #ef4444;
  --color-scrollbar: #cbd5e1;
  --color-scrollbar-hover: #94a3b8;
  --theme-sidebar-logo-icon-color: #38bdf8;
  --theme-logo-text-color: #e2efff;
}

/* 极客青主题：简洁青绿 */
[data-theme="green"] {
  --theme-sidebar-bg-start:     #0f766e;
  --theme-sidebar-bg-end:       #0f766e;
  --theme-sidebar-active-color: #ffffff;
  --theme-sidebar-active-bg:   rgba(74, 222, 128, 0.12);
  --theme-sidebar-active-icon-color: #4ade80;
  --theme-sidebar-text:        rgba(187, 220, 200, 0.65);
  --theme-sidebar-text-hover:  rgba(220, 255, 235, 0.92);
  --theme-sidebar-text-active: #ffffff;
  --theme-sidebar-group-title: rgba(74, 222, 128, 0.35);
  --theme-sidebar-group-title-hover: rgba(74, 222, 128, 0.65);
  --theme-sidebar-hover-bg:   rgba(74, 222, 128, 0.06);
  --theme-sidebar-logo-icon-bg: rgba(74, 222, 128, 0.15);
  --theme-sidebar-border:      rgba(74, 222, 128, 0.08);
  --theme-sidebar-nav-icon:    rgba(148, 190, 165, 0.45);
  --theme-sidebar-user-avatar-bg: rgba(74, 222, 128, 0.1);
  --theme-sidebar-user-avatar-border: rgba(74, 222, 128, 0.25);
  --theme-sidebar-user-name:    #ecfdf5;
  --theme-sidebar-user-role:    rgba(148, 190, 165, 0.45);
  --theme-sidebar-chevron:     rgba(148, 190, 165, 0.3);
  --theme-sidebar-dropdown-bg:  #052e16;
  --theme-sidebar-dropdown-border: rgba(74, 222, 128, 0.12);
  --theme-sidebar-dropdown-item: rgba(187, 220, 200, 0.75);
  --theme-sidebar-dropdown-item-hover: #ffffff;
  --theme-sidebar-dropdown-svg: rgba(148, 190, 165, 0.45);
  --theme-sidebar-danger-hover-bg: rgba(239, 68, 68, 0.2);
  --theme-sidebar-danger-hover-color: #fca5a5;
  --theme-sidebar-collapse-btn-bg: rgba(74, 222, 128, 0.08);
  --theme-sidebar-collapse-btn-color: rgba(148, 190, 165, 0.65);
  --theme-sidebar-collapse-btn-hover-bg: rgba(74, 222, 128, 0.18);
  --theme-sidebar-collapse-btn-hover-color: #ffffff;
  --theme-main-bg:     #f0fdf7;
  --theme-new-tag-bg:  #0891b2;
  --color-scrollbar: #cbd5e1;
  --color-scrollbar-hover: #94a3b8;
  --theme-sidebar-logo-icon-color: #ffffff;
}

/* 响应式 */
@media (max-width: 768px) {
  .hidden-mobile { display: none !important; }
}
@media (min-width: 769px) {
  .hidden-desktop { display: none !important; }
}

/* ============================
   TableActions Dropdown Fix
   ============================ */
.ta-dropdown-popper {
  z-index: 9999 !important;
}

/* ============================
   Tooltip — 现代化提示框
   ============================ */
.el-tooltip__popper,
.el-tooltip__trigger {
  outline: none !important;
}

.el-tooltip__popper {
  font-family: 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif !important;
}

.el-tooltip__popper.is-dark {
  background: linear-gradient(135deg, #1f2937 0%, #111827 100%) !important;
  border: 1px solid rgba(255, 255, 255, 0.1) !important;
  border-radius: 8px !important;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3) !important;
  padding: 8px 12px !important;
  font-size: 12px !important;
  font-weight: 500 !important;
  max-width: 280px !important;
}

.el-tooltip__popper.is-dark .el-tooltip__arrow::before {
  background: #111827 !important;
}

/* ============================
   Popover — 弹出卡片样式
   ============================ */
.el-popover.el-popper {
  border: 1px solid var(--color-border-light) !important;
  border-radius: var(--radius-lg) !important;
  box-shadow: var(--shadow-lg) !important;
  background: var(--color-surface) !important;
  font-family: 'Manrope', sans-serif !important;
  padding: 12px !important;
}

/* ============================
   Dropdown — 下拉菜单
   ============================ */
.el-dropdown-menu {
  border: 1px solid var(--color-border-light) !important;
  border-radius: var(--radius-lg) !important;
  box-shadow: var(--shadow-lg) !important;
  background: var(--color-surface) !important;
  padding: 6px !important;
  font-family: 'Manrope', sans-serif !important;
}

.el-dropdown-menu__item {
  border-radius: var(--radius-md) !important;
  font-size: 13px !important;
  font-weight: 500 !important;
  padding: 8px 12px !important;
  color: var(--color-text-primary) !important;
  transition: all 0.15s ease !important;
}

.el-dropdown-menu__item:hover {
  background: var(--gray-50) !important;
  color: var(--color-primary) !important;
}

.el-dropdown-menu__item--divided {
  border-top: 1px solid var(--color-border-light) !important;
  margin-top: 6px !important;
}

/* ============================
   Dropdown Popper
   ============================ */
.el-dropdown__popper.el-popper.is-light {
  border: 1px solid var(--color-border-light) !important;
  border-radius: var(--radius-lg) !important;
  box-shadow: var(--shadow-lg) !important;
}

/* ============================
   Badge / Tag 增强
   ============================ */
.el-badge__content {
  border-radius: var(--radius-full) !important;
  font-weight: 600 !important;
  font-size: 10px !important;
  padding: 0 6px !important;
  height: 18px !important;
  line-height: 18px !important;
}

/* ============================
   Tabs 标签页
   ============================ */
.el-tabs__header {
  margin-bottom: 16px !important;
}

.el-tabs__item {
  font-family: 'Manrope', sans-serif !important;
  font-weight: 600 !important;
  font-size: 13px !important;
  color: var(--color-text-secondary) !important;
  padding: 0 16px !important;
  height: 40px !important;
  line-height: 40px !important;
  transition: all 0.2s ease !important;
}

.el-tabs__item:hover {
  color: var(--color-primary) !important;
}

.el-tabs__item.is-active {
  color: var(--color-primary) !important;
  font-weight: 700 !important;
}

.el-tabs__active-bar {
  height: 2px !important;
  border-radius: 2px !important;
  background: var(--color-primary) !important;
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
}

.el-tabs__nav-wrap::after {
  height: 1px !important;
  background: var(--color-border-light) !important;
}

/* ============================
   Progress 进度条
   ============================ */
.el-progress-bar__outer {
  border-radius: var(--radius-full) !important;
  background: var(--gray-100) !important;
}

.el-progress-bar__inner {
  border-radius: var(--radius-full) !important;
  transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1) !important;
}

.el-progress__text {
  font-family: 'Manrope', sans-serif !important;
  font-weight: 600 !important;
  font-size: 12px !important;
}

/* ============================
   Slider 滑块
   ============================ */
.el-slider__runway {
  height: 6px !important;
  border-radius: var(--radius-full) !important;
  background: var(--gray-100) !important;
}

.el-slider__bar {
  height: 6px !important;
  border-radius: var(--radius-full) !important;
  background: linear-gradient(90deg, var(--color-primary) 0%, var(--color-primary-hover) 100%) !important;
}

.el-slider__button {
  width: 18px !important;
  height: 18px !important;
  border: 2px solid var(--color-primary) !important;
  background: #fff !important;
  box-shadow: 0 2px 8px rgba(0, 94, 235, 0.2) !important;
  transition: all 0.2s ease !important;
}

.el-slider__button:hover {
  transform: scale(1.1) !important;
  box-shadow: 0 4px 12px rgba(0, 94, 235, 0.3) !important;
}

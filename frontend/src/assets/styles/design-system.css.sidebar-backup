/* ==================== 通用工具类 ==================== */
.truncate {
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.font-headline { font-family: 'Manrope', sans-serif; }
.text-primary  { color: var(--color-primary); }
.text-muted    { color: var(--color-text-muted); }
.text-secondary { color: var(--color-text-secondary); }

/* 状态 Chip */
.status-chip {
  display: inline-flex; align-items: center;
  padding: 2px 10px; border-radius: var(--radius-full);
  font-size: 11px; font-weight: 600;
}
.status-chip--success { background: var(--color-success-bg); color: var(--color-success-text); }
.status-chip--warning { background: var(--color-warning-bg); color: var(--color-warning-text); }
.status-chip--danger  { background: var(--color-danger-bg);  color: var(--color-danger-text);  }
.status-chip--info    { background: var(--gray-100);         color: var(--color-text-secondary); }

/* 滚动条 */
:root {
  --color-scrollbar: #cbd5e1;
  --color-scrollbar-hover: #94a3b8;
  --theme-badge-ad-bg: #7c3aed;
  --theme-badge-local-bg: #64748b;
}


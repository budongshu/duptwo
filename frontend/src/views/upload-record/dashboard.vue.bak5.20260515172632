// 周期对比
const periodComparison = (data: number[], windowSize = 7) => {
  if (data.length < windowSize * 2) return 0
  const recent = data.slice(-windowSize).reduce((a, b) => a + b, 0)
  const prev = data.slice(-windowSize * 2, -windowSize).reduce((a, b) => a + b, 0)
  if (prev === 0) return recent > 0 ? 100 : 0
  return Math.round(((recent - prev) / prev) * 100)
}


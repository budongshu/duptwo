// ==================== Project Bar List (CSS) ====================
const updateProjectBarList = () => {
  const all = (statistics.byProject || [])
    .map((p: any) => ({ projectName: p.projectName || '(空)', count: p.count || 0, totalSize: p.totalSize || 0 }))
    .sort((a, b) => b.count - a.count)
    .slice(0, 10)

  const maxCount = all.length > 0 ? all[0].count : 1
  projectBarList.value = all.map(p => ({ ...p, pct: Math.round((p.count / maxCount) * 100) }))
}

// ==================== Disk Label Distribution (CSS) ====================
const updateDataTypeChart = () => {
  let all = statistics.byDiskLabel || []

  // filter by project
  if (diskLabelProjectFilter.value !== 'all') {
    all = all.filter((d: any) => (d.projectName || 'null') === diskLabelProjectFilter.value)
  }

  const grouped = new Map<string, { diskLabel: string; count: number; totalSize: number }>()

  all.forEach((d: any) => {
    let key: string
    if (diskLabelPrefix.value === 'all') {
      key = d.diskLabel || '(空)'
    } else if (diskLabelPrefix.value === 'custom') {
      key = (d.diskLabel || '').slice(0, diskLabelCustomLen.value) || '(空)'
    } else {
      const len = parseInt(diskLabelPrefix.value)
      key = (d.diskLabel || '').slice(0, len) || '(空)'
    }

    const existing = grouped.get(key)
    if (existing) {
      existing.count += d.count || 0
      existing.totalSize += d.totalSize || 0
    } else {
      grouped.set(key, { diskLabel: key, count: d.count || 0, totalSize: d.totalSize || 0 })
    }
  })

  const arr = [...grouped.values()].sort((a, b) => {
    return diskLabelShowMode.value === 'size' ? b.totalSize - a.totalSize : b.count - a.count
  }).slice(0, 20)

  const maxVal = arr.length > 0 ? (diskLabelShowMode.value === 'size' ? arr[0].totalSize : arr[0].count) : 1
  diskLabelList.value = arr.map(item => ({
    diskLabel: item.diskLabel,
    count: item.count,
    totalSize: item.totalSize,
    pct: Math.round((diskLabelShowMode.value === 'size' ? item.totalSize : item.count) / maxVal * 100),
  }))
}

// ==================== 磁盘状态数据加载 ====================
const loadDiskLabels = async () => {
  diskLabelsLoading.value = true
  try {
    const params: Record<string, any> = {}
    Object.assign(params, getGlobalFilterParams())
    // 项目过滤
    if (diskFilterProject.value) params.projectName = diskFilterProject.value
    // 标签过滤
    if (diskFilterLabel.value) params.diskLabel = diskFilterLabel.value
    // 时间过滤
    if (diskCustomRange.value?.length === 2) {
      params.startDate = diskCustomRange.value[0]
      params.endDate = diskCustomRange.value[1]
    } else {
      const today = new Date()
      const fmt = (d: Date) => d.toISOString().split('T')[0]
      switch (diskTimeKey.value) {
        case 'all': break
        case 'today': params.startDate = fmt(today); params.endDate = fmt(today); break
        case 'yesterday': { const d = new Date(today); d.setDate(d.getDate() - 1); params.startDate = fmt(d); params.endDate = fmt(d); break }
        case '3d': { const d = new Date(today); d.setDate(d.getDate() - 2); params.startDate = fmt(d); params.endDate = fmt(today); break }
        case '7d': { const d = new Date(today); d.setDate(d.getDate() - 6); params.startDate = fmt(d); params.endDate = fmt(today); break }
        case '30d': { const d = new Date(today); d.setDate(d.getDate() - 29); params.startDate = fmt(d); params.endDate = fmt(today); break }
        case '1y': { const d = new Date(today); d.setFullYear(d.getFullYear() - 1); params.startDate = fmt(d); params.endDate = fmt(today); break }
      }
    }
    const res = await UploadRecordApi.diskLabels(params)
    diskLabels.value = res.data || []
    diskLabelTotal.value = diskLabels.value.length
  } catch { /* silently fail */ }
  diskLabelsLoading.value = false
}

const setDiskTime = (key: typeof diskTimeKey.value) => {
  diskTimeKey.value = key
  if (key !== 'custom') {
    showDiskCustom.value = false
    diskCustomRange.value = null

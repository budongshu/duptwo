// ==================== Spark Charts ====================
const updateSparkCharts = () => {
  if (!echarts) return
  const stats = statCards.value
  stats.forEach((card) => {
    const el = sparkRefs.value[card.key]
    if (!el || !card.sparkData || card.sparkData.length === 0) return

    if (sparkCharts[card.key]) sparkCharts[card.key].dispose()
    const chart = echarts.init(el)
    sparkCharts[card.key] = chart

    const hexColor = sparkColorMap[card.key] || '#3b82f6'
    chart.setOption({
      grid: { top: 0, right: 0, bottom: 0, left: 0 },
      xAxis: { type: 'category', data: card.sparkData.map((_: any, i: number) => i), show: false },
      yAxis: { type: 'value', show: false, min: (val: any) => Math.floor(val.min * 0.9) },
      series: [{
        type: 'line',
        data: card.sparkData,
        smooth: true,
        symbol: 'none',
        lineStyle: { color: hexColor, width: 1.5 },
      }],
    })
  })
}


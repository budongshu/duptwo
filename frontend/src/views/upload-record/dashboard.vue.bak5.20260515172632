  font-weight: 600;
  color: var(--color-text-muted);
  width: 22px;
  text-align: right;
  flex-shrink: 0;
}
.date-panel__picker {
  flex: 1;
}
.date-panel__picker :deep(.el-input__wrapper) {
  background: var(--color-surface-2);
  box-shadow: none !important;
  border: 1px solid var(--color-border);
  border-radius: 6px;
  padding: 0 6px;
  transition: border-color 0.15s;
}
.date-panel__picker :deep(.el-input__wrapper:hover),
.date-panel__picker :deep(.el-input__wrapper.is-focus) {
  border-color: var(--color-primary);
}
.date-panel__picker :deep(.el-input__inner) {
  font-size: 12px;
  color: var(--color-text-primary);
}
.date-panel__divider {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 2px 0;
}
.date-panel__line {
  flex: 1;
  height: 1px;
  background: var(--color-border-light);
}
.date-panel__arrow {
  font-size: 10px;
  color: var(--color-text-muted);
}
.date-panel__summary {
  text-align: center;
  font-size: 11px;
  font-weight: 600;
  color: var(--color-primary);
  background: var(--color-primary-light-9);
  padding: 4px 8px;
  border-radius: 4px;
}
.date-panel__actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 6px;
  border-top: 1px solid var(--color-border-light);
}
.date-panel__actions .el-button--small {
  font-size: 12px;
}

/* 日期下拉面板 */
.date-dropdown-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9998;
}
.date-dropdown {
  position: fixed;
  z-index: 9999;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-md);
  min-width: 220px;
}
.date-trigger-wrap {
  flex-shrink: 0;
}
.time-preset-btn:hover:not(.is-active) {
  color: var(--color-primary);
  background: var(--color-primary-light-9);
}
.time-preset-btn.is-active {
  background: var(--color-primary);
  color: #fff;
  font-weight: 700;
  box-shadow: 0 1px 3px rgba(27,58,138,0.3);
}
.page-title {
  font-size: 24px;
  font-weight: 800;
  color: var(--color-text-primary);
  margin: 0;
  letter-spacing: -0.5px;
  -webkit-font-smoothing: antialiased;
}

/* 自动刷新指示器 */
.auto-refresh {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  font-size: 12px;
  color: var(--color-text-secondary);
}
.auto-refresh .refresh-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--color-success);
  animation: pulse 2s ease-in-out infinite;
}
.auto-refresh.refreshing .refresh-dot {
  background: var(--color-warning);
  animation: none;
}
.auto-refresh.refreshing .refresh-text {
  color: var(--color-warning);
  font-weight: 600;
}
@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.6; transform: scale(0.85); }
}

/* ==================== KPI 卡片行 ==================== */
.stats-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-bottom: 14px;
}

/* filter-strip 已移除，改用 Popover 方式 */

/* ==================== KPI 卡片 ==================== */

.stat-card {
  flex: 1 1 calc(20% - 14px);
  min-width: 160px;
  background: var(--color-surface);
  border: 1px solid var(--color-border-light);
  border-radius: var(--radius-lg);
  padding: 16px;
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  position: relative;
  transition: box-shadow var(--duration-normal) var(--ease-out);
  display: flex;
  flex-direction: column;
  animation: card-appear 0.5s var(--ease-spring) both;
}
.stat-card:hover {
  box-shadow: var(--shadow-md);
}

/* 图标 + 标签行 */
.stat-card__top {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 10px;
}
.stat-card__icon-wrap {
  width: 36px;
  height: 36px;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.stat-card__icon-svg {
  width: 18px;
  height: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-secondary);
}
.stat-card__label {
  font-size: 12px;
  font-weight: 600;
  color: var(--color-text-secondary);
  text-transform: uppercase;
  letter-spacing: 0.3px;
}

/* 数字 + 单位 */
.stat-card__value-row {
  display: flex;
  align-items: baseline;
  gap: 4px;
  margin-bottom: 8px;
}
.stat-card__big-value {
  font-size: 32px;
  font-weight: 800;
  color: var(--color-text-primary);
  line-height: 1;
  letter-spacing: -1.5px;
  -webkit-font-smoothing: antialiased;
  font-family: 'Manrope', 'Inter', system-ui, sans-serif;
}
.stat-card__unit {
  font-size: 13px;
  font-weight: 600;
  color: var(--color-text-muted);
}

/* 对比徽章 */
.stat-card__meta {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 4px;
  min-height: 22px;
}
.stat-card__size {
  font-size: 13px;
  font-weight: 700;
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
}
.stat-card__comparison {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  font-size: 11px;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: var(--radius-sm);
}
.stat-card__comparison.trend--up {
  color: var(--color-trend-up);
  background: var(--color-trend-up-bg);
}
.stat-card__comparison.trend--down {
  color: var(--color-trend-down);
  background: var(--color-trend-down-bg);
}

/* 迷你趋势线 (Sparkline) */
.stat-card__spark {
  width: 100%;
  height: 40px;
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: center;
}
.stat-card__sparkline { width: 100%; height: 40px; }

/* 成功率 ring gauge (50x50px) */
.rate-gauge { display: flex; align-items: center; justify-content: center; }
.rate-gauge__svg { width: 50px; height: 50px; }
.rate-gauge__bg {
  fill: none;
  stroke: var(--color-surface-3);
  stroke-width: 4;
  stroke-linecap: round;
}
.rate-gauge__fill {
  fill: none;
  stroke: var(--chart-green);
  stroke-width: 4;
  stroke-linecap: round;
  transform: rotate(-90deg);
  transform-origin: 25px 25px;
  transition: stroke-dasharray 0.6s ease;
}
.rate-gauge__text {
  font-family: 'Manrope', 'Inter', sans-serif;
  font-size: 10px;
  font-weight: 700;
  fill: var(--color-text-primary);
}

/* ==================== Skeleton Loading ==================== */
.skeleton-card {
  .skeleton {
    background: linear-gradient(90deg, var(--gray-100) 25%, var(--gray-50) 50%, var(--gray-100) 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
    border-radius: var(--radius-sm);
  }
  .sk-circle {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    margin-bottom: 8px;
  }
}
@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

/* ==================== 图表网格布局（行分组）==================== */
.row-grid {
  display: grid;
  gap: 14px;
  margin-bottom: 14px;
}
.row-grid--2col {
  grid-template-columns: 1fr 1fr;
}
.row-grid--2col-40-60 {
  grid-template-columns: 2fr 3fr;
}
.align-stretch .panel,
.align-stretch .insight-panel {
  align-self: stretch;
}

/* ==================== 面板通用 ==================== */
.panel {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--color-border-light);
  transition: box-shadow var(--duration-normal) var(--ease-out);
}
.panel:hover { box-shadow: var(--shadow-md); }

.panel__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 18px;
  border-bottom: 1px solid var(--color-border-light);
  flex-wrap: wrap;
  gap: 8px;
}
.panel__title {
  font-size: 14px;
  font-weight: 700;
  color: var(--color-text-primary);
  -webkit-font-smoothing: antialiased;
}
.panel__meta {
  font-size: 12px;
  color: var(--color-text-muted);
  font-weight: 500;
  flex-shrink: 0;
}
.panel__header-right {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: nowrap;
  min-width: 0;
  overflow: hidden;
}
/* ==================== 统一过滤工具栏 ==================== */
.filter-toolbar {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: nowrap;
  min-width: 0;
  overflow: hidden;
}
.filter-select { min-width: 90px; max-width: 120px; }
.filter-select--time { min-width: 80px; max-width: 100px; }
.filter-select :deep(.el-select__wrapper) {
  height: 30px !important;
  min-height: 30px !important;
  border-radius: 6px;
  box-shadow: none !important;
  background: var(--color-surface-2);
  border: 1px solid var(--color-border);
  display: flex;
  align-items: center;
}
.filter-select :deep(.el-select__wrapper:hover) { border-color: var(--color-primary); }
.filter-select :deep(.el-select__wrapper.is-focused) {
  border-color: var(--color-primary) !important;
  box-shadow: 0 0 0 2px rgba(64, 158, 255, 0.1) !important;
}
.filter-select :deep(.el-select__input) { font-size: 12px; font-weight: 600; }
.filter-select :deep(.el-select__placeholder) { font-size: 12px; font-weight: 600; }

.filter-date-picker { width: 170px; }
.filter-meta {
  font-size: 11px;
  color: var(--color-text-muted);
  white-space: nowrap;
  margin-left: 4px;
}

/* ==================== 图表画布 ==================== */
.chart-canvas { width: 100%; }
.chart-canvas--trend { height: 340px; }

/* ==================== 洞察面板容器 ==================== */
.insight-panel {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  border: 1px solid var(--color-border-light);
  box-shadow: var(--shadow-sm);
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  overflow: hidden;
}

.insight-card {
  background: transparent;
  border: 1px solid var(--color-border-light);
  border-radius: var(--radius-md);
  padding: 14px 16px;
  display: flex;
  align-items: flex-start;
  gap: 14px;
  transition: box-shadow var(--duration-normal) var(--ease-out), border-color var(--duration-fast);
  flex: 1;
}
.insight-card:hover {
  box-shadow: var(--shadow-md);
  border-color: var(--color-primary);
}
.insight-card__icon {
  width: 40px;
  height: 40px;
  border-radius: var(--radius-md);
  background: var(--color-primary-light-9);
  color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.insight-card__body {
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}
.insight-card__title {
  font-size: 11.5px;
  font-weight: 700;
  color: var(--color-text-secondary);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.insight-card__desc {
  font-size: 12.5px;
  color: var(--color-text-primary);
  line-height: 1.5;
}
.diskstatus-header-right {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: nowrap;
  overflow: hidden;
}
.diskstatus-select { min-width: 68px; max-width: 80px; }
.diskstatus-time-group {
  display: inline-flex;
  align-items: center;
  background: var(--color-surface-2);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  padding: 2px;
  gap: 1px;
}
.diskstatus-time-btn {
  padding: 3px 8px;
  border: none;
  background: transparent;
  border-radius: calc(var(--radius-sm) - 1px);
  font-size: 11px;
  font-weight: 600;
  color: var(--color-text-muted);
  cursor: pointer;
  transition: all var(--duration-fast);
  outline: none;
  white-space: nowrap;
}
/* ==================== 磁盘标签样式 (保留) ==================== */
.diskstatus-time-btn:hover:not(.is-active) {
  color: var(--color-primary);
  background: var(--color-primary-light-9);
}
.diskstatus-time-btn.is-active {
  background: var(--color-primary);
  color: #fff;
  font-weight: 700;
}
/* ==================== Row 高度对齐 ==================== */
.panel__body--diskstatus {
  display: flex;
  flex-direction: column;
  min-height: 320px;
}
.diskstatus-loading { padding: 12px 16px; }
.diskstatus-skeleton-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(90px, 1fr));
  gap: 8px;
}
.diskstatus-skeleton {
  height: 60px;
  border-radius: var(--radius-md);
  background: linear-gradient(90deg, var(--gray-100) 25%, var(--gray-50) 50%, var(--gray-100) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}
.diskstatus-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 24px 20px;
  color: var(--color-text-muted);
  font-size: 12px;
}
.diskstatus-grid-scroll {
  padding: 10px 16px 0;
  max-height: 240px;
  overflow-y: auto;
}
.diskstatus-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(72px, 1fr));
  gap: 6px;
}
.diskstatus-tile {
  border-radius: var(--radius-md);
  padding: 6px 4px 5px;
  cursor: default;
  transition: transform var(--duration-fast), box-shadow var(--duration-fast);
  min-height: 48px;
  display: flex;
  align-items: stretch;
}
.diskstatus-tile:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}
.diskstatus-tile--completed { background: #dcfce7; border: 1px solid #86efac; }
.diskstatus-tile--failed { background: #fee2e2; border: 1px solid #fca5a5; }
.diskstatus-tile--mixed { background: #fef3c7; border: 1px solid #fcd34d; }
.diskstatus-tile--pending { background: var(--color-surface-2); border: 1px solid var(--color-border); }
.diskstatus-tile__inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  width: 100%;
}
.diskstatus-tile__name {
  font-size: 10.5px;
  font-weight: 600;
  color: var(--color-text-primary);
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
  line-height: 1.3;
}
.diskstatus-tile__count {
  font-size: 16px;
  font-weight: 800;
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
  line-height: 1;
}
.diskstatus-tile__size {
  font-size: 10px;
  color: var(--color-text-muted);
  font-weight: 500;
  white-space: nowrap;
}
.diskstatus-legend {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 8px 16px 10px;
  flex-wrap: wrap;
}
.diskstatus-legend__item {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 11px;
  color: var(--color-text-muted);
  font-weight: 500;
}
.diskstatus-legend__dot {
  width: 10px;
  height: 10px;
  border-radius: 2px;
  flex-shrink: 0;
}
.diskstatus-legend__item--completed .diskstatus-legend__dot { background: #86efac; }
.diskstatus-legend__item--failed .diskstatus-legend__dot { background: #fca5a5; }
.diskstatus-legend__item--mixed .diskstatus-legend__dot { background: #fcd34d; }
.diskstatus-legend__item--pending .diskstatus-legend__dot { background: var(--color-border); }

/* ==================== 全屏趋势图 Modal ==================== */
/* ==================== 全屏 Overlay ==================== */
.fs-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  z-index: 2000;
  overflow-y: auto;
}
.fs-dialog {
  background: var(--color-page-bg);
  width: 100%;
  min-height: 100vh;
  animation: fs-in 0.2s ease;
}
@keyframes fs-in {
  from { opacity: 0; transform: scale(0.98); }
  to { opacity: 1; transform: scale(1); }
}
.fs-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 16px;
  background: var(--color-surface);
  border-bottom: 1px solid var(--color-border-light);
  flex-shrink: 0;
}
.fs-title {
  font-size: 15px;
  font-weight: 700;
  color: var(--color-text-primary);
}
.fs-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border: none;
  background: transparent;
  border-radius: var(--radius-sm);
  color: var(--color-text-muted);
  cursor: pointer;
  transition: all var(--duration-fast);
}
.fs-close:hover {
  background: var(--color-border-light);
  color: var(--color-text-primary);
}
.fs-toolbar {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 8px 16px;
  background: var(--color-surface);
  border-bottom: 1px solid var(--color-border-light);
  flex-shrink: 0;
}
.fs-chart-wrap {
  padding: 12px 16px 16px;
  overflow: hidden;
}
.fs-chart {
  width: 100%;
  height: 520px;
  background: var(--color-surface);
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border-light);
}
.trend-fullscreen-dialog .el-dialog__body {
  padding: 0;
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.trend-fullscreen-toolbar {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 20px;
  background: var(--color-surface);
  border-bottom: 1px solid var(--color-border-light);
  flex-wrap: nowrap;
}
.trend-fullscreen-chart {
  flex: 1;
  min-height: 0;
  padding: 16px;
  background: var(--color-page-bg);
}
.trend-fullscreen-body {
  flex: 1;
  min-height: 0;
  padding: 16px;
  background: var(--color-page-bg);
}

.trend-fullscreen-toolbar .filter-scroll {
  flex-shrink: 0;
}
.trend-fullscreen-body {
  flex: 1;
  min-height: 0;
  padding: 20px;
  background: var(--color-page-bg);
}
.disk-fullscreen-dialog .el-dialog__header {
  display: none;
}
.disk-fullscreen-dialog .el-dialog__body {
  padding: 0;
  height: 100vh;
}
.disk-fullscreen-body {
  height: 100%;
  padding: 20px;
  background: var(--color-page-bg);
  overflow-y: auto;
}
.disk-fullscreen-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
  gap: 12px;
}
.disk-fullscreen-tile {
  background: var(--color-surface);
  border: 1px solid var(--color-border-light);
  border-radius: var(--radius-md);
  padding: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: border-color var(--duration-fast);
}
.disk-fullscreen-tile:hover {
  border-color: var(--color-border);
}
.disk-fullscreen-tile__inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  width: 100%;
}
.disk-fullscreen-label {
  font-size: 11px;
  color: var(--color-text-secondary);
  word-break: break-all;
  text-align: center;
  line-height: 1.2;
}
.disk-fullscreen-count {
  font-size: 20px;
  font-weight: 800;
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
  line-height: 1;
}
.disk-fullscreen-size {
  font-size: 11px;
  font-weight: 600;
  color: var(--color-text-muted);
  font-variant-numeric: tabular-nums;
}
.disk-fullscreen-tile--completed { background: #f0fdf4; border-color: #bbf7d0; }
.disk-fullscreen-tile--failed { background: #fef2f2; border-color: #fecaca; }
.disk-fullscreen-tile--mixed { background: #fffbeb; border-color: #fde68a; }
.disk-fullscreen-tile--pending { background: #eff6ff; border-color: #bfdbfe; }
.disk-fullscreen-tile--processing { background: #f5f3ff; border-color: #ddd6fe; }

/* ==================== 项目分布面板 ==================== */
.panel__body--project {
  padding: 0;
  max-height: 320px;
  overflow-y: auto;
}
.project-header-right {
  display: flex;
  align-items: center;
  gap: 10px;
}
.project-stat {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 11px;
  color: var(--color-text-muted);
  font-weight: 500;
}
.project-list {
  padding: 4px 0;
}
.project-row {
  display: grid;
  grid-template-columns: 22px 10px 1fr 100px 130px 44px;
  gap: 6px;
  align-items: center;
  padding: 5px 16px;
  font-size: 12px;

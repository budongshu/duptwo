const loadGlobalStats = async () => {
  try {
    const params = { ...getGlobalFilterParams() }
    const res = await UploadRecordApi.statistics(params)
    const data = res.data || {}
    statistics.todayCount = data.todayCount ?? 0
    statistics.todaySize = data.todaySize ?? 0
    statistics.todaySizeStr = data.todaySizeStr ?? '0 B'
    ;(statistics as any).todayByStatus = data.todayByStatus || []
    statistics.weekCount = data.weekCount ?? 0
    statistics.weekSize = data.weekSize ?? 0
    statistics.weekSizeStr = data.weekSizeStr || '—'
    statistics.monthCount = data.monthCount ?? 0
    statistics.monthSize = data.monthSize ?? 0
    statistics.monthSizeStr = data.monthSizeStr || '—'
    statistics.totalCount = data.totalCount ?? 0
    statistics.totalSize = data.totalSize ?? 0
    statistics.totalSizeStr = data.totalSizeStr ?? '0 B'
    statistics.byStatus = data.byStatus || []
    nextTick(() => triggerCountAnimations())
  } catch { /* silently fail */ }
}

const loadFilteredStats = async () => {
  try {
    const params: Record<string, any> = {}
    Object.assign(params, getGlobalFilterParams())
    if (dateRange.value?.length === 2) { params.startDate = dateRange.value[0]; params.endDate = dateRange.value[1] }
    if (searchProjectName.value) params.projectName = searchProjectName.value
    if (searchStatus.value) params.status = searchStatus.value
    if (searchUploader.value) params.uploader = searchUploader.value

    const res = await UploadRecordApi.statistics(params)
    const data = res.data || {}
    statistics.todayCount = data.todayCount ?? 0
    statistics.todaySize = data.todaySize ?? 0
    statistics.todaySizeStr = data.todaySizeStr ?? '0 B'
    ;(statistics as any).todayByStatus = data.todayByStatus || []
    statistics.weekCount = data.weekCount ?? 0
    statistics.weekSize = data.weekSize ?? 0
    statistics.weekSizeStr = data.weekSizeStr || '—'
    statistics.monthCount = data.monthCount ?? 0
    statistics.monthSize = data.monthSize ?? 0
    statistics.monthSizeStr = data.monthSizeStr || '—'
    statistics.totalCount = data.totalCount ?? 0
    statistics.totalSize = data.totalSize ?? 0
    statistics.totalSizeStr = data.totalSizeStr ?? '0 B'
    statistics.byStatus = data.byStatus || []
    statistics.byProject = data.byProject || []
    statistics.byDiskLabel = data.byDiskLabel || []

    updateProjectBarList()
    updateDataTypeChart()
    nextTick(() => triggerCountAnimations())
  } catch (e) { console.error('loadFilteredStats failed', e) }
}

const loadRecentRecords = async () => {
  try {
    const params: any = { ...getGlobalFilterParams(), limit: 20 }
    const res = await UploadRecordApi.recent(params)
    recentRecords.value = res.data || []
  } catch { /* silently fail */ }
}

const loadOptions = async () => {
  try {
    const [diskRes, uploaderRes, projectRes] = await Promise.all([
      UploadRecordApi.diskLabels(),
      UploadRecordApi.uploaderList(),
      ProjectApi.getSimpleList(),
    ])
    diskLabelOptions.value = (diskRes.data || []).map((d: any) => d.diskLabel)
    uploaderOptions.value = uploaderRes.data || []
    projectList.value = projectRes.data || []
  } catch { /* silently fail */ }
}

const handleFilterChange = () => {
  setGlobalFilter({
    projectName: searchProjectName.value,
    status: searchStatus.value,
    uploader: searchUploader.value,
  })
  setTimeRange(activeTimePreset.value)
  loadFilteredStats()
  loadGlobalStats()
  loadRecentRecords()
  loadTrendData()
}

const handleDateRangeChange = () => {
  loadTrendData()
  loadFilteredStats()
  loadGlobalStats()
}

const resetAllFilters = () => {
  searchProjectName.value = ''
  searchStatus.value = ''
  searchUploader.value = ''
  clearGlobalFilter()
  setTimePreset('all')
}

// ==================== 生命周期 ====================
onMounted(async () => {
  setTimeRange('month')
  await loadOptions()
  await loadGlobalStats()
  await loadFilteredStats()
  await loadTrendData()
  await loadRecentRecords()
  await loadDiskLabels()
  await nextTick()
  await initCharts()
  isInitialLoading.value = false

  refreshTimer = setInterval(() => {
    nextRefresh.value = 30
    const tick = setInterval(() => { nextRefresh.value--; if (nextRefresh.value <= 0) clearInterval(tick) }, 1000)
    loadGlobalStats()
    loadFilteredStats()
    loadTrendData()
    loadRecentRecords()
    loadDiskLabels()
    updateProjectBarList()
    updateDataTypeChart()
  }, 30000)
})

onUnmounted(() => {
  if (refreshTimer) clearInterval(refreshTimer)
  trendChart?.dispose()
  Object.values(sparkCharts).forEach((c: any) => c?.dispose())
  window.removeEventListener('resize', handleResize)
})

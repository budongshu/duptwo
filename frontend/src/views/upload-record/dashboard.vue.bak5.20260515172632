// ==================== 动画计数器 ====================
const animatedValues = reactive<Record<string, number>>({})
const animationFrames: Record<string, number> = {}

const animateValue = (target: number, key: string, duration = 800) => {
  if (animationFrames[key]) cancelAnimationFrame(animationFrames[key])
  const start = animatedValues[key] ?? 0
  if (start === target) { animatedValues[key] = target; return }
  const startTime = performance.now()
  const easeOutExpo = (t: number) => (t === 1 ? 1 : 1 - Math.pow(2, -10 * t))
  const step = (now: number) => {
    const elapsed = now - startTime
    const progress = Math.min(elapsed / duration, 1)
    animatedValues[key] = Math.round(start + (target - start) * easeOutExpo(progress))
    if (progress < 1) {
      animationFrames[key] = requestAnimationFrame(step)
    } else {
      animatedValues[key] = target
      delete animationFrames[key]
    }
  }
  animationFrames[key] = requestAnimationFrame(step)
}

